// KIELER warning experiment W4 (not part of the controller): a loop whose
// transitions are ALL immediate (no delayed transition) - the causality error
// of brief Section 1.3. Expected: the warning AND a scheduling error, no code.
scchart NoDelay {
    input bool t
    output int L = 0
    region R {
        initial state A { entry do L = 1 }
        immediate if t go to B
        state B { entry do L = 2 }
        immediate if !t go to A
    }
}
