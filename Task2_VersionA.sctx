// =====================================================================
//  COMPSYS 303 Assignment - Part 1, Task 2
//  Pedestrian Traffic Light Controller - Version A (Timed SCCharts clocks)

//  Three concurrent regions: Lights (the Task 1 cycle, with each walk phase
//  as a sub-machine inside its green state running on its own clock), plus
//  NSRequest and EWRequest, which count button presses.

//  LEDR: bits 5..0 the lamps of Table 1, bit 6 the NS walk light, bit 7 the
//  EW walk light.  Every phase state and walk state writes the whole word in
//  its entry action, so a yellow phase clears a walk bit by rewriting it.

// AI Use Declaration: The design and all design decisions were made by Harold and Lucas.
// The SCChart code was written with the assistance of a generative AI tool (Claude,
// Anthropic), then reviewed, simulated and verified by Harold and Lucas in KIELER.
// =====================================================================
@ClocksUseSD
scchart Task2_PedestrianTrafficLight_A {

    // ---------- Configurability (Section 3): time-outs in seconds ----------
    const float T1 = 6.0  // G-R  NS green,  EW red
    const float T2 = 2.0  // Y-R  NS yellow, EW red
    const float T3 = 0.5  // R-R  all red (after NS)
    const float T4 = 6.0  // R-G  NS red,   EW green
    const float T5 = 2.0  // R-Y  NS red,   EW yellow
    const float T6 = 0.5  // R-R  all red (after EW)
    const float WALK_TIME = 4.0   // pedestrian walk phase (< green time)

    // ---------- Table 1: lamp bits of the red LED word ----------
    const int NS_G = 1, NS_Y = 2, NS_R = 4, EW_G = 8, EW_Y = 16, EW_R = 32
    const int NS_PED = 64, EW_PED = 128   // bits 6 and 7: the pedestrian lights

    // ---------- Reactive interface ----------
    input  bool NSraised, EWraised    // pedestrian request buttons (events)
    output int  LEDR = 33    // 8 red LEDs: lamps (5..0), NS walk (6), EW walk (7); 33 = G-R

    // ---------- Shared variables (single writer each; Lights reads via pre) ----------
    int nsRequests = 0, ewRequests = 0  // presses counted, written by NSRequest / EWRequest only
    int nsServed = 0,   ewServed = 0  // presses served, written and read by Lights only

    // ---------- Time (first-class): the phase clock ----------
    clock c = 0.0      // seconds since the current phase was entered

    // ------------------------------------------------------------------
    region Lights {

        initial state GR "G-R: NS green, EW red" {
            clock wNS = 0.0                         // NS walk clock, local to this green
            entry do c = 0.0; LEDR = EW_R + NS_G    // 33; the walk states add / remove bit 6

            region NSWalk {
                initial state DecideNS
                    immediate if pre(nsRequests) > nsServed
                        do nsServed = pre(nsRequests); wNS = 0.0 go to WalkNS   // request pending
                    immediate if !(pre(nsRequests) > nsServed) go to NoWalkNS

                state WalkNS "NS walk light on" {
                    entry do LEDR = EW_R + NS_G + NS_PED    // 97
                }
                immediate if wNS >= WALK_TIME do nsServed = pre(nsRequests) go to NoWalkNS

                state NoWalkNS "NS walk light off" {
                    entry do LEDR = EW_R + NS_G          // 33
                }
            }
        }
        immediate if c >= T1 go to YR

        state YR "Y-R: NS yellow, EW red" {
            entry do c = 0.0; LEDR = EW_R + NS_Y // 34: whole word rewritten, so the NS walk bit is off
        }
        immediate if c >= T2 go to RR1

        state RR1 "R-R: all red" {
            entry do c = 0.0; LEDR = EW_R + NS_R // 36
        }
        immediate if c >= T3 go to RG

        state RG "R-G: NS red, EW green" {
            clock wEW = 0.0     // EW walk clock, local to this green
            entry do c = 0.0; LEDR = EW_G + NS_R    // 12; the walk states add / remove bit 7

            region EWWalk {
                initial state DecideEW
                    immediate if pre(ewRequests) > ewServed
                        do ewServed = pre(ewRequests); wEW = 0.0 go to WalkEW
                    immediate if !(pre(ewRequests) > ewServed) go to NoWalkEW

                state WalkEW "EW walk light on" {
                    entry do LEDR = EW_G + NS_R + EW_PED    // 140
                }
                immediate if wEW >= WALK_TIME do ewServed = pre(ewRequests) go to NoWalkEW

                state NoWalkEW "EW walk light off" {
                    entry do LEDR = EW_G + NS_R   // 12
                }
            }
        }
        immediate if c >= T4 go to RY

        state RY "R-Y: NS red, EW yellow" {
            entry do c = 0.0; LEDR = EW_Y + NS_R  // 20: whole word rewritten, so the EW walk bit is off
        }
        immediate if c >= T5 go to RR2

        state RR2 "R-R: all red" {
            entry do c = 0.0; LEDR = EW_R + NS_R  // 36
        }
        if c >= T6 go to GR  // the ONE delayed transition of the cycle
    }

    // ------------------------------------------------------------------
    region NSRequest {
        initial state ReleasedNS
            immediate if NSraised do nsRequests++ go to PressedNS  // one request per press

        state PressedNS "NS button held"
            if !NSraised go to ReleasedNS  // delayed: closes this loop
    }

    // ------------------------------------------------------------------
    region EWRequest {
        initial state ReleasedEW
            immediate if EWraised do ewRequests++ go to PressedEW

        state PressedEW "EW button held"
            if !EWraised go to ReleasedEW // delayed: closes this loop
    }
}
